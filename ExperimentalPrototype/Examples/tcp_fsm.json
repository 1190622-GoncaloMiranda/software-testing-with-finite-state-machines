{
  "name": "TcpConnectionFSM",
  "initialState": "CLOSED",
  "states": [
    "CLOSED",
    "LISTEN",
    "SYN_SENT",
    "SYN_RECEIVED",
    "ESTABLISHED",
    "FIN_WAIT_1",
    "FIN_WAIT_2",
    "CLOSE_WAIT",
    "CLOSING",
    "LAST_ACK",
    "TIME_WAIT"
  ],
  "transitions": [
    { "from": "CLOSED",       "to": "LISTEN",       "input": "passive_open",  "output": "listening"        },
    { "from": "CLOSED",       "to": "SYN_SENT",     "input": "active_open",   "output": "send_syn"         },
    { "from": "LISTEN",       "to": "SYN_RECEIVED", "input": "recv_syn",      "output": "send_syn_ack"     },
    { "from": "LISTEN",       "to": "CLOSED",       "input": "close",         "output": "stop_listen"      },
    { "from": "SYN_SENT",     "to": "ESTABLISHED",  "input": "recv_syn_ack",  "output": "send_ack"         },
    { "from": "SYN_SENT",     "to": "SYN_RECEIVED", "input": "recv_syn",      "output": "send_syn_ack"     },
    { "from": "SYN_SENT",     "to": "CLOSED",       "input": "close",         "output": "abort"            },
    { "from": "SYN_RECEIVED", "to": "ESTABLISHED",  "input": "recv_ack",      "output": "connection_up"    },
    { "from": "SYN_RECEIVED", "to": "FIN_WAIT_1",   "input": "close",         "output": "send_fin"         },
    { "from": "ESTABLISHED",  "to": "FIN_WAIT_1",   "input": "close",         "output": "send_fin"         },
    { "from": "ESTABLISHED",  "to": "CLOSE_WAIT",   "input": "recv_fin",      "output": "send_ack"         },
    { "from": "FIN_WAIT_1",   "to": "FIN_WAIT_2",   "input": "recv_ack",      "output": "wait_fin"         },
    { "from": "FIN_WAIT_1",   "to": "CLOSING",      "input": "recv_fin",      "output": "send_ack"         },
    { "from": "FIN_WAIT_1",   "to": "TIME_WAIT",    "input": "recv_fin_ack",  "output": "send_ack"         },
    { "from": "FIN_WAIT_2",   "to": "TIME_WAIT",    "input": "recv_fin",      "output": "send_ack"         },
    { "from": "CLOSE_WAIT",   "to": "LAST_ACK",     "input": "close",         "output": "send_fin"         },
    { "from": "CLOSING",      "to": "TIME_WAIT",    "input": "recv_ack",      "output": "wait_timeout"     },
    { "from": "LAST_ACK",     "to": "CLOSED",       "input": "recv_ack",      "output": "closed"           },
    { "from": "TIME_WAIT",    "to": "CLOSED",       "input": "timeout",       "output": "closed"           }
  ]
}
