{
  "name": "TlsClientFSM",
  "initialState": "Start",
  "states": [
    "Start",
    "ClientHelloSent",
    "Resuming",
    "SessionResumed",
    "ServerHelloReceived",
    "CertificateReceived",
    "ServerKeyExchangeReceived",
    "ServerHelloDoneReceived",
    "ClientKeyExchangeSent",
    "ChangeCipherSpecSent",
    "ClientFinishedSent",
    "ServerCCSReceived",
    "Established",
    "Renegotiating",
    "CloseNotifySent",
    "CloseNotifyReceived",
    "FatalAlertSent",
    "FatalAlertReceived",
    "ConnectionLost",
    "Closed"
  ],
  "transitions": [
    { "from": "Start",                     "to": "ClientHelloSent",           "input": "send_client_hello",          "output": "client_hello"            },
    { "from": "Start",                     "to": "Resuming",                  "input": "send_client_hello_resume",   "output": "client_hello_resume"     },
    { "from": "ClientHelloSent",           "to": "ServerHelloReceived",       "input": "recv_server_hello",          "output": "server_hello"            },
    { "from": "ClientHelloSent",           "to": "FatalAlertReceived",        "input": "recv_handshake_failure",     "output": "handshake_failure"       },
    { "from": "ClientHelloSent",           "to": "ConnectionLost",            "input": "timeout",                    "output": "timeout_abort"           },
    { "from": "Resuming",                  "to": "SessionResumed",            "input": "recv_server_hello_resume",   "output": "session_resumed"         },
    { "from": "Resuming",                  "to": "ServerHelloReceived",       "input": "recv_full_handshake",        "output": "fallback_to_full"        },
    { "from": "SessionResumed",            "to": "Established",               "input": "complete_resume",            "output": "data_ready"              },
    { "from": "ServerHelloReceived",       "to": "CertificateReceived",       "input": "recv_certificate",           "output": "certificate"             },
    { "from": "ServerHelloReceived",       "to": "FatalAlertSent",            "input": "invalid_version",            "output": "send_protocol_alert"     },
    { "from": "CertificateReceived",       "to": "ServerKeyExchangeReceived", "input": "recv_server_key_exchange",   "output": "server_key_exchange"     },
    { "from": "CertificateReceived",       "to": "ServerHelloDoneReceived",   "input": "recv_server_hello_done",     "output": "no_ske_continue"         },
    { "from": "CertificateReceived",       "to": "FatalAlertSent",            "input": "invalid_cert",               "output": "send_bad_cert_alert"     },
    { "from": "ServerKeyExchangeReceived", "to": "ServerHelloDoneReceived",   "input": "recv_server_hello_done",     "output": "all_received"            },
    { "from": "ServerHelloDoneReceived",   "to": "ClientKeyExchangeSent",     "input": "send_client_key_exchange",   "output": "client_key_exchange"     },
    { "from": "ClientKeyExchangeSent",     "to": "ChangeCipherSpecSent",      "input": "send_change_cipher_spec",    "output": "ccs_sent"                },
    { "from": "ChangeCipherSpecSent",      "to": "ClientFinishedSent",        "input": "send_finished",              "output": "finished_sent"           },
    { "from": "ClientFinishedSent",        "to": "ServerCCSReceived",         "input": "recv_change_cipher_spec",    "output": "ccs_received"            },
    { "from": "ServerCCSReceived",         "to": "Established",               "input": "recv_finished",              "output": "handshake_done"          },
    { "from": "ServerCCSReceived",         "to": "FatalAlertReceived",        "input": "invalid_finished",           "output": "finished_mismatch"       },
    { "from": "Established",               "to": "Established",               "input": "app_data",                   "output": "data_exchanged"          },
    { "from": "Established",               "to": "Renegotiating",             "input": "renegotiate",                "output": "renegotiation_started"   },
    { "from": "Established",               "to": "CloseNotifySent",           "input": "send_close_notify",          "output": "closing"                 },
    { "from": "Established",               "to": "CloseNotifyReceived",       "input": "recv_close_notify",          "output": "peer_closing"            },
    { "from": "Established",               "to": "FatalAlertReceived",        "input": "recv_fatal_alert",           "output": "abort"                   },
    { "from": "Established",               "to": "ConnectionLost",            "input": "conn_lost",                  "output": "connection_lost"         },
    { "from": "Renegotiating",             "to": "ClientHelloSent",           "input": "send_new_client_hello",      "output": "renegotiation_hello"     },
    { "from": "CloseNotifySent",           "to": "Closed",                    "input": "recv_close_notify",          "output": "both_closed"             },
    { "from": "CloseNotifySent",           "to": "ConnectionLost",            "input": "timeout",                    "output": "timeout_abort"           },
    { "from": "CloseNotifyReceived",       "to": "Closed",                    "input": "send_close_notify",          "output": "both_closed"             },
    { "from": "FatalAlertSent",            "to": "Closed",                    "input": "cleanup",                    "output": "aborted_closed"          },
    { "from": "FatalAlertReceived",        "to": "Closed",                    "input": "cleanup",                    "output": "aborted_closed"          },
    { "from": "ConnectionLost",            "to": "Closed",                    "input": "cleanup",                    "output": "closed"                  },
    { "from": "Closed",                    "to": "Start",                     "input": "reset",                      "output": "ready"                   }
  ]
}
